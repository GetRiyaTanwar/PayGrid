# ==============================================================================
# PayGrid - Environment Configuration Template
# Copy this file to .env and configure values for your environment
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Active Spring Profile (e.g. dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/paygrid
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver

# Security & JWT Configuration
# Note: Secret must be at least 256 bits (32 bytes) for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# JPA & Hibernate Settings
JPA_SHOW_SQL=false
JPA_HIBERNATE_DDL_AUTO=validate

